# Copy to compose/.env for local 4-role Docker pipeline.
DATASETS_ROOT=../../datasets

BIRD_PG_USER=bird
BIRD_PG_PASSWORD=bird
BIRD_PG_DB=bird
BIRD_PG_PORT=55432
BIRD_PG_HOST=bird-postgres

BIRD_OLAP_USER=olap
BIRD_OLAP_PASSWORD=olap

OLLAMA_PORT=11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_MODEL=qwen2.5:7b-instruct

DORIS_FE_HOST=doris-fe
DORIS_QUERY_PORT=9030
DORIS_DATABASE=bird_minidev_olap
DORIS_USER=root
DORIS_PASSWORD=

DB_ALLOWED_SCHEMAS=california_schools,card_games,codebase_community,debit_card_specializing,european_football_2,financial,formula_1,student_club,superhero,thrombosis_prediction,toxicology

LANGCHAIN_API_PORT=8011
CHAINLIT_PORT=8501
KAFKA_PORT=9092
CONNECT_PORT=8083
DORIS_HTTP_PORT=8030
