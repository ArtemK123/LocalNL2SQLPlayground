# EC2 compose/.env template (SSM deploy scripts append private IPs).
DATASETS_ROOT=/opt/doris-test/bird-assets

BIRD_PG_USER=bird
BIRD_PG_PASSWORD=bird
BIRD_PG_DB=bird
BIRD_PG_PORT=5432

BIRD_OLAP_USER=olap
BIRD_OLAP_PASSWORD=olap

OLLAMA_PRIMARY_MODEL=Snowflake/Arctic-Text2SQL-R1-7B
OLLAMA_FALLBACK_MODEL=Snowflake/Arctic-Text2SQL-R1-7B

# ollama | vllm — set LLM_BACKEND=vllm after deploy-gpu-vllm-from-s3.ps1
LLM_BACKEND=ollama
VLLM_BASE_URL=
ARCTIC_SQL_DIALECT=mysql
SQL_EXEC_MODE=skip
SQL_REPAIR_MAX_RETRIES=0

# Study-parity OmniSQL CREATE TABLE (one db_id). Guard qualifies as schema.table for Doris.
SCHEMA_SOURCE=bird_tables
BIRD_TABLES_JSON=/app/data/dev_tables.json
SCHEMA_SELECTOR_MODE=bm25
SCHEMA_BM25_INCLUDE_FK=true
SCHEMA_FINAL_TOP_K=8

# Stack DB target: leave DB_URI empty to use Doris defaults below, or set
# DB_BACKEND=postgres + DB_URI=postgresql+psycopg://… to flip the API connection.
DB_BACKEND=doris
DB_DIALECT=mysql

DORIS_QUERY_PORT=9030
DORIS_DATABASE=bird_minidev_olap
DORIS_USER=root
DORIS_PASSWORD=

DB_ALLOWED_SCHEMAS=california_schools,card_games,codebase_community,debit_card_specializing,european_football_2,financial,formula_1,student_club,superhero,thrombosis_prediction,toxicology

# When true, API filters live catalog to schema_name == request.db_id (Doris CDC).
# Set false for single-schema Postgres public profile.
DB_ID_AS_SCHEMA=true

BIRD_DATASET_PREFIX=doris-test/package
