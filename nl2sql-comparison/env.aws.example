# Copy to compose/.env on each EC2 role after terraform apply.
# Fill private IPs from: terraform -chdir=terraform/compute output

# BIRD: upload from laptop with scripts/aws/upload-bird-to-s3.ps1; DB host loads via stage-bird-assets.sh (S3 only).
BIRD_DATASET_BUCKET=
BIRD_DATASET_PREFIX=nl2sql-comparison/bird
BIRD_DATASET_VERSION=
BIRD_DATASET_LOCAL_DIR=/opt/nl2sql-comparison/bird-assets

BIRD_PG_USER=bird
BIRD_PG_PASSWORD=bird
BIRD_PG_DB=bird
BIRD_PG_PORT=5432
# DB host private IP (db role) вЂ” used by NL2SQL stacks
BIRD_PG_HOST=10.50.1.XX

OLLAMA_PORT=11434
# GPU host private IP (Ollama native API, or vLLM OpenAI port mapped to 11434)
OLLAMA_HOST=http://10.50.1.YY:11434

# LLM backend: ollama | vllm (vLLM uses OpenAI-compatible /v1 on VLLM_BASE_URL)
LLM_BACKEND=ollama
# Same host:11434 when using deploy-gpu-vllm-from-s3.ps1 (maps container :8000 -> host :11434)
VLLM_BASE_URL=http://10.50.1.YY:11434
VLLM_MODEL=Snowflake/Arctic-Text2SQL-R1-7B
# L4 capacity defaults (not tied to harness workers). Optional: VLLM_MAX_NUM_SEQS ops override.
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_MAX_NUM_SEQS=
# VLLM_ENFORCE_EAGER=0

# Model catalog (AWS GPU). Switch runtime model: scripts/aws/set-gpu-model.ps1
# Ollama SQL: local Q4_K_M tag from mradermacher GGUF (ensure-arctic-q4.sh).
# vLLM SQL: HuggingFace Snowflake/Arctic-Text2SQL-R1-7B (set LLM_BACKEND=vllm).
OLLAMA_SQL_MODEL="arctic-text2sql-r1-7b:q4_k_m"
OLLAMA_GENERAL_MODEL=qwen2.5-coder:14b-instruct-q8_0
OLLAMA_ACTIVE_MODEL="arctic-text2sql-r1-7b:q4_k_m"
OLLAMA_PRIMARY_MODEL="arctic-text2sql-r1-7b:q4_k_m"
OLLAMA_FALLBACK_MODEL="arctic-text2sql-r1-7b:q4_k_m"
OLLAMA_NUM_CTX=4096
# 512 matches Study-path one-pass Arctic (CoT skipped via SQL-fence prefill).
OLLAMA_NUM_PREDICT=512
LLM_HTTP_TIMEOUT_SEC=20
ARCTIC_SQL_FENCE_PREFILL=true
ARCTIC_SQL_DIALECT=sqlite
# Concurrent Ollama request slots (ignored when LLM_BACKEND=vllm)
OLLAMA_NUM_PARALLEL=2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# LangChain: AWS full BIRD uses all minidev tables in public (75 tables). Filter by db_id at request time.
BIRD_DB_PROFILE=public

# DB_ALLOWED_SCHEMAS: optional restrict list; omit or leave empty for all user schemas.
# 1-db smoke (formula_1 in public only): DB_ALLOWED_SCHEMAS=public

# WrenAI: full BIRD minidev (11 schemas). Bootstrap uses WREN_TARGET_TABLES=* + WREN_TARGET_SCHEMAS filter.
WREN_TARGET_TABLES=*
WREN_TARGET_SCHEMAS=california_schools,card_games,codebase_community,debit_card_specializing,european_football_2,financial,formula_1,student_club,superhero,thrombosis_prediction,toxicology
WREN_COLUMN_INDEXING_BATCH_SIZE=8
# Max tables passed to SQL generation per question (Wren table_retrieval_size; 75 = full BIRD public catalog)
WREN_TABLE_RETRIEVAL_SIZE=75
WREN_TABLE_COLUMN_RETRIEVAL_SIZE=500

# LangChain stack: Study-parity BM25 (top_k=8 + FK) CREATE TABLE schema from tables.json
SCHEMA_SOURCE=bird_tables
BIRD_TABLES_JSON=/app/data/dev_tables.json
SCHEMA_SELECTION_ENABLED=true
SCHEMA_SHORTLIST_TOP_M=25
SCHEMA_FINAL_TOP_K=8
SCHEMA_BM25_INCLUDE_FK=true
SCHEMA_SELECTOR_MODE=bm25
SCHEMA_REFRESH_SECONDS=3600
NL2SQL_FAST_MODE=true
SQL_REPAIR_MAX_RETRIES=0
SQL_EXEC_MODE=skip

PREMSQL_API_PORT=8010
PREMSQL_PLAYGROUND_PORT=8501
PREMSQL_PLAYGROUND_API_PORT=8000

NL2SQL_RO_USER=nl2sql_ro
NL2SQL_RO_PASSWORD=nl2sql_ro
BIRD_OLAP_USER=olap
BIRD_OLAP_PASSWORD=olap
