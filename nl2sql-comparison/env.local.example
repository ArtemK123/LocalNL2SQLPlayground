# Copy to compose/.env for local 3-role smoke tests.
# Prerequisite order (local harness): up-db → load_bird_1db → up-gpu → up-stack-<name>
# Full BIRD (AWS / multi-schema): up-db → load_bird_dev → ...
#
# LLM policy: local laptop uses qwen2.5:7b-instruct (fast dev smoke).
# AWS cluster uses env.aws.example → Arctic (a-kore/Arctic-Text2SQL-R1-7B).

# Repo datasets/ (full BIRD_dev for load_bird_dev.ps1; not required for 1-db harness)
DATASETS_ROOT=../../datasets

# DB_ALLOWED_SCHEMAS: optional restrict list; omit or leave empty for all user schemas. 1-db smoke: DB_ALLOWED_SCHEMAS=public

BIRD_PG_USER=bird
BIRD_PG_PASSWORD=bird
BIRD_PG_DB=bird
BIRD_PG_PORT=55432
BIRD_PG_HOST=bird-postgres

BIRD_OLAP_USER=olap
BIRD_OLAP_PASSWORD=olap
NL2SQL_RO_USER=nl2sql_ro
NL2SQL_RO_PASSWORD=nl2sql_ro

OLLAMA_PORT=11434
OLLAMA_HOST=http://ollama:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Wren: full minidev multi-schema (load_bird_dev.ps1). For 1-db formula_1-only use WREN_TARGET_SCHEMAS=public or public-only tables.
WREN_TARGET_TABLES=*
WREN_TARGET_SCHEMAS=california_schools,card_games,codebase_community,debit_card_specializing,european_football_2,financial,formula_1,student_club,superhero,thrombosis_prediction,toxicology
WREN_COLUMN_INDEXING_BATCH_SIZE=10
# Max tables passed to SQL generation per question (Wren table_retrieval_size; 75 = full BIRD public catalog)
WREN_TABLE_RETRIEVAL_SIZE=75
WREN_TABLE_COLUMN_RETRIEVAL_SIZE=500

LANGCHAIN_API_PORT=8011
DBGPT_API_PORT=8012
DBGPT_PORT=5670
PREMSQL_API_PORT=8010
PREMSQL_PLAYGROUND_PORT=8501
PREMSQL_PLAYGROUND_API_PORT=8000
VANNA_PORT=8001
HOST_PORT=3001
CHAT2DB_PORT=10825

# LangChain API tuning (defaults in compose/stacks/langchain; override here if needed)
SCHEMA_SELECTION_ENABLED=true
SCHEMA_SHORTLIST_TOP_M=25
SCHEMA_FINAL_TOP_K=5
SCHEMA_SELECTOR_MODE=heuristic
SCHEMA_REFRESH_SECONDS=3600
NL2SQL_FAST_MODE=true
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
# GPU Ollama concurrent slots (compose/docker-compose.gpu.yml); raise carefully on small GPUs
OLLAMA_NUM_PARALLEL=2
SQL_REPAIR_MAX_RETRIES=1

# Chainlit UI (langchain stack — use: up-stack -Stack langchain -WithUI)
CHAINLIT_PORT=8501
CHAINLIT_USERNAME=admin
CHAINLIT_PASSWORD=admin

# Harness benchmarks: pip install -e harness[ui] (Python 3.10+); see harness/README.md
